@model IEnumerable<HospitalFlow.Models.Room>

@{
    ViewData["Title"] = "Facility Map";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5"><i class="fas fa-hospital-symbol text-danger"></i> Hospital Rooms</h1>
        <a asp-action="Create" class="btn btn-danger shadow-sm">
            <i class="fas fa-plus"></i> Add New Room
        </a>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            var count = item.Equipments?.Count ?? 0;
            var max = item.MaxCapacity > 0 ? item.MaxCapacity : 1;
            var percent = (count * 100) / max;

            string barColor = percent >= 100 ? "bg-danger" : (percent >= 80 ? "bg-warning" : "bg-success");
            var currentPatient = item.Patients?.FirstOrDefault();

            <div class="col-xl-3 col-lg-4 col-md-6 mb-4">
                <div class="card h-100 shadow-sm border-0 border-top border-4 @(item.Status == RoomStatus.CleaningRequired ? "border-warning" : "border-info")">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <!-- Header: Room Name & Status -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h5 class="card-title text-dark mb-0">@item.Name</h5>
                                    <span class="badge bg-light text-dark border">@item.Department</span>
                                </div>

                                @switch (item.Status)
                                {
                                    case RoomStatus.Available:
                                        <span class="badge bg-success">Available</span>
                                        break;
                                    case RoomStatus.Occupied:
                                        <span class="badge bg-primary">Occupied</span>
                                        break;
                                    case RoomStatus.CleaningRequired:
                                        <span class="badge bg-warning text-dark">Needs Cleaning</span>
                                        break;
                                    case RoomStatus.Maintenance:
                                        <span class="badge bg-secondary">Maintenance</span>
                                        break;
                                }
                            </div>

                            <!-- Patient Info Block -->
                            <div class="my-3 p-2 rounded bg-light border">
                                @if (currentPatient != null)
                                {
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-truncate" style="max-width: 140px;">
                                            <i class="fas fa-user text-muted me-1"></i>@currentPatient.FullName
                                        </span>

                                        @switch (currentPatient.AcuityLevel)
                                        {
                                            case PatientAcuity.Critical:
                                                <span class="badge bg-danger">Critical</span>
                                                break;
                                            case PatientAcuity.Monitoring:
                                                <span class="badge bg-warning text-dark">Monitoring</span>
                                                break;
                                            default:
                                                <span class="badge bg-info text-dark">Stable</span>
                                                break;
                                        }
                                    </div>
                                    <small class="text-muted d-block mt-1">MRN: @currentPatient.MedicalRecordNumber</small>

                                    <form asp-action="DischargePatient" method="post" class="mt-2">
                                        <input type="hidden" name="patientId" value="@currentPatient.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100 py-0">
                                            <i class="fas fa-sign-out-alt"></i> Discharge
                                        </button>
                                    </form>

                                    <form asp-controller="Patients" asp-action="Delete" method="post" class="mt-1" onsubmit="return confirm('Delete this patient record?');">
                                        <input type="hidden" name="id" value="@currentPatient.Id" />
                                        <button type="submit" class="btn btn-sm btn-link text-danger text-decoration-none p-0 w-100 text-center" style="font-size: 0.75rem;">
                                            <i class="fas fa-trash-alt"></i> Remove Record
                                        </button>
                                    </form>

                                }
                                else
                                {
                                    <div class="text-muted small py-1 text-center">
                                        <em>No patient assigned</em>
                                    </div>

                                    @if (item.Status == RoomStatus.Available)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-primary w-100 mt-1"
                                                data-bs-toggle="modal"
                                                data-bs-target="#assignPatientModal"
                                                data-room-id="@item.Id"
                                                data-room-name="@item.Name">
                                            <i class="fas fa-user-plus"></i> Assign Patient
                                        </button>
                                    }
                                    else if (item.Status == RoomStatus.CleaningRequired)
                                    {
                                        <form asp-action="MarkSanitized" method="post" class="mt-1">
                                            <input type="hidden" name="roomId" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-success w-100 py-0">
                                                <i class="fas fa-broom"></i> Mark Clean
                                            </button>
                                        </form>
                                    }
                                }
                            </div>

                            <!-- Equipment Occupancy Progress -->
                            <div class="mt-2">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="text-muted">Equipment Load</small>
                                    <small class="fw-bold">@count / @item.MaxCapacity</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar @barColor" role="progressbar" style="width: @percent%"></div>
                                </div>
                                @if (percent >= 100)
                                {
                                    <small class="text-danger fw-bold"><i class="fas fa-exclamation-triangle"></i> Equipment Full</small>
                                }
                            </div>
                        </div>

                        <!-- Card Footer Links -->
                        <div class="pt-3 mt-3 border-top d-flex justify-content-between align-items-center">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-link text-decoration-none p-0">View Details</a>
                            <div class="btn-group">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="fas fa-cog"></i></a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fas fa-trash"></i></a>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        }
    </div>
</div>



<!-- Assign Patient Modal -->
<div class="modal fade" id="assignPatientModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AssignPatient" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="assignModalLabel">Admit Patient to Room</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="roomId" id="modalRoomId" />

                    <div class="mb-3">
                        <label class="form-label fw-bold">Target Room</label>
                        <input type="text" id="modalRoomName" class="form-control" readonly disabled />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Patient</label>
                        @{
                            var unassigned = ViewBag.UnassignedPatients as List<HospitalFlow.Models.Patient>;
                        }
                        @if (unassigned != null && unassigned.Any())
                        {
                            <select name="patientId" class="form-select" required>
                                <option value="">-- Choose Patient --</option>
                                @foreach (var p in unassigned)
                                {
                                    <option value="@p.Id">@p.FullName (MRN: @p.MedicalRecordNumber)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0 small">
                                No unassigned patients waiting in triage.
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    @if (unassigned != null && unassigned.Any())
                    {
                        <button type="submit" class="btn btn-primary">Admit to Room</button>
                    }
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.1/signalr.min.js"></script>

    <script>
        var connection = new signalR.HubConnectionBuilder()
        .withUrl("/hospitalHub")
        .build();

        connection.on("RefreshData", function () {
        console.log("SignalR: Change detected! Reloading page...");
        location.reload();
        });

        connection.start().catch(function (err) {
        return console.error(err.toString());
        });



        var assignModal = document.getElementById('assignPatientModal');
        if (assignModal) {
        assignModal.addEventListener('show.bs.modal', function (event) {
        var button = event.relatedTarget;
        var roomId = button.getAttribute('data-room-id');
        var roomName = button.getAttribute('data-room-name');

        document.getElementById('modalRoomId').value = roomId;
        document.getElementById('modalRoomName').value = roomName;
        });
        }



    </script>
}