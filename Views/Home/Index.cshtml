@{
    ViewData["Title"] = "Command Center";
}

<div class="hospitalflow-workspace text-white">

    <!-- MAIN HEADER -->
    <div class="command-banner p-4 p-md-5 mb-4 rounded-3 border border-dark position-relative overflow-hidden">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-4 position-relative z-index-10">
            <div>
                <div class="text-rose text-uppercase tracking-widest font-monospace mb-2" style="font-size: 0.75rem; font-weight: 700;">
                    <span class="d-inline-block rounded-circle bg-success me-2" style="width: 8px; height: 8px;"></span>
                    Hospital Operations Dashboard
                </div>
                <h1 class="display-6 fw-bold tracking-tight text-white m-0">
                    Hospital<span class="text-secondary-muted font-light">Flow</span>
                </h1>
                <p class="text-muted fs-6 mt-2 mb-0">
                    Real time room availability, equipment management, and clinical decision support.
                </p>
            </div>

            @if (!User.Identity!.IsAuthenticated)
            {
                <div class="flex-shrink-0">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-authenticate px-4 py-2 fw-semibold border-0 shadow">
                        Staff Sign In
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- MAIN NAVIGATION PANELS -->
    <div class="row g-4">
        <!-- MODULE 1: ROOMS & CAPACITY -->
        <div class="col-md-6">
            <div class="bento-panel h-100 p-4 rounded-3 border border-dark position-relative cursor-pointer" onclick="location.href='@Url.Action("Index", "Rooms")'">
                <div class="panel-accent-line bg-danger"></div>

                <div class="d-flex flex-column justify-content-between h-100">
                    <div class="panel-content-top">
                        <div class="icon-frame bg-danger-alpha border border-danger-subtle rounded-3 d-flex align-items-center justify-content-center mb-3">
                            <i class="fas fa-bed text-danger fs-5"></i>
                        </div>
                        <h4 class="fw-bold tracking-tight text-white mb-2 panel-title">Room & Bed Management</h4>
                        <p class="text-muted fs-7 mb-3">
                            Check real time room occupancy, assign patient beds, and manage ICU or isolation capacity.
                        </p>
                    </div>

                    <div class="panel-action-link fs-7 fw-semibold text-muted transition">
                        View Rooms & Wings <i class="fas fa-arrow-right ms-1"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODULE 2: EQUIPMENT INVENTORY -->
        <div class="col-md-6">
            <div class="bento-panel h-100 p-4 rounded-3 border border-dark position-relative cursor-pointer" onclick="location.href='@Url.Action("Index", "Equipments")'">
                <div class="panel-accent-line bg-info"></div>

                <div class="d-flex flex-column justify-content-between h-100">
                    <div class="panel-content-top">
                        <div class="icon-frame bg-info-alpha border border-info-subtle rounded-3 d-flex align-items-center justify-content-center mb-3">
                            <i class="fas fa-stethoscope text-info fs-5"></i>
                        </div>
                        <h4 class="fw-bold tracking-tight text-white mb-2 panel-title">Medical Equipment</h4>
                        <p class="text-muted fs-7 mb-3">
                            Track device locations, monitor scheduled maintenance, and check availability across departments.
                        </p>
                    </div>

                    <div class="panel-action-link fs-7 fw-semibold text-muted transition">
                        View Equipment Inventory <i class="fas fa-arrow-right ms-1"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- MODULE 3: CLINICAL ASSISTANT -->
    <div class="row g-4 mt-1">
        <div class="col-12">
            <div class="bento-panel p-4 rounded-3 border border-dark position-relative">
                <div class="panel-accent-line bg-warning"></div>

                <div class="icon-frame bg-warning-alpha border border-warning-subtle rounded-3 d-flex align-items-center justify-content-center mb-3">
                    <i class="fas fa-robot text-warning fs-5"></i>
                </div>
                <h4 class="fw-bold tracking-tight text-white mb-2">Clinical Support Assistant</h4>
                <p class="text-muted fs-7 mb-3">
                    Ask quick operational questions regarding unit protocols, room prep, or asset allocations.
                </p>

                @if (User.Identity!.IsAuthenticated)
                {
                    <div class="ai-console border border-dark rounded-3 bg-black-alpha p-3 mb-3" style="min-height: 100px; max-height: 250px; overflow-y: auto;">
                        <div id="aiResponseOutput" class="text-muted fs-7">
                            Ask a question below to query the operational assistant.
                        </div>
                    </div>

                    <div class="input-group border border-dark rounded-3 overflow-hidden bg-black-alpha p-1">
                        <input type="text" id="aiInputPrompt" class="form-control bg-transparent text-white border-0 fs-7 shadow-none ps-3" placeholder="e.g., How many ventilators are currently available?" />
                        <button id="submitAiQuery" class="btn btn-warning fw-semibold fs-7 px-4 py-2 border-0">
                            Send
                        </button>
                    </div>
                }
                else
                {
                    <div class="border border-dark rounded-3 bg-black-alpha p-3 text-center text-muted fs-7">
                        Please sign in to access the operational assistant.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById("submitAiQuery")?.addEventListener("click", async () => {
        const inputField = document.getElementById("aiInputPrompt");
        const outputField = document.getElementById("aiResponseOutput");
        const promptText = inputField.value.trim();

        if (!promptText) return;

        outputField.innerHTML = `<span class="text-warning">Thinking...</span>`;
        inputField.value = "";

        try {
            const response = await fetch("/api/ai/ask", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ prompt: promptText })
            });

            if (response.ok) {
                const data = await response.json();
                outputField.innerText = data.response;
            } else {
                outputField.innerHTML = `<span class="text-danger">Unable to load response (Status: ${response.status}). Please try again.</span>`;
            }
        } catch (error) {
            outputField.innerHTML = `<span class="text-danger">Connection lost. Check your network and try again.</span>`;
        }
    });
</script>