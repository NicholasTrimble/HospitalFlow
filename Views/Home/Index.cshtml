@{
    ViewData["Title"] = "Command Center";
}

<div class="hospitalflow-workspace text-white">

    <!-- EXECUTIVE BANNER WORKSPACE -->
    <div class="command-banner p-5 mb-5 rounded-3 border border-dark position-relative overflow-hidden">
        <div class="position-absolute end-0 top-0 h-100 w-25 bg-pulse-glow opacity-10 pointer-events-none"></div>
        
        <div class="d-flex flex-col flex-md-row justify-content-between align-items-start align-items-md-center gap-4 position-relative z-index-10">
            <div>
                <div class="text-rose text-uppercase tracking-widest font-monospace mb-2" style="font-size: 0.7rem; font-weight: 700;">
                    <span class="d-inline-block rounded-circle bg-danger animate-pulse-dot me-2" style="width: 6px; height: 6px;"></span>
                    Clinical Logistics Management Matrix // Standby
                </div>
                <h1 class="display-5 fw-bold tracking-tight text-white m-0">
                    Hospital<span class="text-secondary-muted font-light">Flow</span>
                </h1>
                <p class="lead text-muted fs-6 font-medium mt-2 mb-0 max-w-xl">
                    Enterprise Medical Asset, Bed Capacity, & Facility Allocation Control Architecture.
                </p>
            </div>

            @if (!User.Identity!.IsAuthenticated)
            {
                <div class="flex-shrink-0">
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-authenticate px-4 py-2.5 fw-semibold border-0 shadow">
                        Authenticate Operator
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- PREMIUM INTERACTIVE MODULE PANELS -->
    <div class="row g-4">
        <!-- MODULE 1: FACILITY WORKSPACE -->
        <div class="col-md-6">
            <div class="bento-panel h-100 p-5 rounded-3 border border-dark position-relative cursor-pointer" onclick="location.href='@Url.Action("Index", "Rooms")'">
                <div class="panel-accent-line bg-danger"></div>
                
                <div class="d-flex flex-column justify-content-between h-100">
                    <div class="panel-content-top">
                        <div class="icon-frame bg-danger-alpha border border-danger-subtle rounded-3 d-flex align-items-center justify-content-center mb-4">
                            <i class="fas fa-door-open text-danger fs-4"></i>
                        </div>
                        <h3 class="fw-bold tracking-tight text-white mb-2 panel-title transition">Facility & Wing Logistics</h3>
                        <p class="text-muted fs-7 leading-relaxed mb-4">
                            Coordinate active hospital footprints, room distribution capacities, critical ICU bays, and isolation workflows in real time.
                        </p>
                    </div>
                    
                    <div class="panel-action-link fs-7 fw-bold text-uppercase tracking-wider text-muted mt-4 transition">
                        Launch Logistics Panel <i class="fas fa-chevron-right ms-1 tracking-arrow transition"></i>
                    </div>
                </div>
            </div>
        </div>

        <!-- MODULE 2: ASSET TRACKING WORKSPACE -->
        <div class="col-md-6">
            <div class="bento-panel h-100 p-5 rounded-3 border border-dark position-relative cursor-pointer" onclick="location.href='@Url.Action("Index", "Equipments")'">
                <div class="panel-accent-line bg-info"></div>
                
                <div class="d-flex flex-column justify-content-between h-100">
                    <div class="panel-content-top">
                        <div class="icon-frame bg-info-alpha border border-info-subtle rounded-3 d-flex align-items-center justify-content-center mb-4">
                            <i class="fas fa-tools text-info fs-4"></i>
                        </div>
                        <h3 class="fw-bold tracking-tight text-white mb-2 panel-title transition">Clinical Telemetry Assets</h3>
                        <p class="text-muted fs-7 leading-relaxed mb-4">
                            Monitor active locations, operational lifecycles, maintenance status tags, and deployment histories for technical telemetry hardware.
                        </p>
                    </div>
                    
                    <div class="panel-action-link fs-7 fw-bold text-uppercase tracking-wider text-muted mt-4 transition">
                        Inspect Asset Register <i class="fas fa-chevron-right ms-1 tracking-arrow transition"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODULE 3: INTELLIGENT COMPLIANCE & RESOURCE ASSISTANT -->
<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="bento-panel p-5 rounded-3 border border-dark position-relative">
            <div class="panel-accent-line bg-warning"></div>

            <div class="icon-frame bg-warning-alpha border border-warning-subtle rounded-3 d-flex align-items-center justify-content-center mb-4">
                <i class="fas fa-microchip text-warning fs-4"></i>
            </div>
            <h3 class="fw-bold tracking-tight text-white mb-2">Operations AI Assistant</h3>
            <p class="text-muted fs-7 leading-relaxed mb-4">
                Query the active database cluster using natural language processing to audit room constraints, analyze equipment status configurations, or identify logistical operational anomalies.
            </p>

            @if (User.Identity!.IsAuthenticated)
            {
                <div class="ai-console border border-dark rounded-3 bg-black-alpha p-4 mb-4" style="min-height: 120px; max-height: 300px; overflow-y: auto;">
                    <div id="aiResponseOutput" class="text-muted fs-7 font-monospace">
                        Console Standby // Awaiting system directive...
                    </div>
                </div>

                <div class="input-group border border-dark rounded-3 overflow-hidden bg-black-alpha p-1">
                    <input type="text" id="aiInputPrompt" class="form-control bg-transparent text-white border-0 fs-7 shadow-none ps-3" placeholder="Describe the resource metric or capacity anomaly you want to query..." />
                    <button id="submitAiQuery" class="btn btn-warning fw-bold fs-7 text-uppercase tracking-wider px-4 py-2 border-0">
                        Execute Query
                    </button>
                </div>
            }
            else
            {
                <div class="border border-dark rounded-3 bg-black-alpha p-4 text-center text-muted fs-7 font-monospace">
                    [Access Denied] - Authenticate operator session to initialize neural system interface.
                </div>
            }
        </div>
    </div>
</div>
</div>

<script>
    document.getElementById("submitAiQuery")?.addEventListener("click", async () => {
        const inputField = document.getElementById("aiInputPrompt");
        const outputField = document.getElementById("aiResponseOutput");
        const promptText = inputField.value.trim();

        if (!promptText) return;

        // Transition UI console states to loading status
        outputField.innerHTML = `<span class="text-warning animate-pulse-dot">Executing Neural Analysis Pipelines... Standby.</span>`;
        inputField.value = "";

        try {
            const response = await fetch("/api/ai/ask", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ prompt: promptText })
            });

            if (response.ok) {
                const data = await response.json();
                // Render text formatting safely preserving DeepSeek layout options
                outputField.innerText = data.response;
            } else {
                outputField.innerHTML = `<span class="text-danger">[ERROR] Request execution failed with code: ${response.status}</span>`;
            }
        } catch (error) {
            outputField.innerHTML = `<span class="text-danger">[ERROR] Neural architecture interface connection dropped.</span>`;
        }
    });
</script>